{
  "expo": {
    "name": "Lire",
    "slug": "lire",
    "scheme": "lire",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yassineelshamy.lire"
    },
    "android": {
      "package": "com.yassineelshamy.lire",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
